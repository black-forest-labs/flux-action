{
  "dataset": "examples.games.dataset:build",
  "source_root": "grunt=<DATA>/grunt_v2,vector=<DATA>/vector_v2",
  "index_dir": "unused",
  "output_dir": "<RUNS>/games",
  "policy": {
    "trunk_weights": "<DEPS>/droid-init-v2b724-ema.safetensors",
    "video_vae_id": "<DEPS>/kinovae.safetensors",
    "text_encoder_id": "<DEPS>/qwen3-vl-4b-instruct",
    "attn_mode": "torch",
    "action_modality": "game",
    "action_dim": 4,
    "camera_layout": "single",
    "camera_keys": ["images.game"],
    "canvas_hw": [512, 512],
    "chunk_size": 32,
    "n_action_steps": 8,
    "fps": 15.0,
    "action_scale": 2.0,
    "gripper_flip_dims": [],
    "caption_dropout": 0.0,
    "augment": false,
    "optimizer_lr": 5e-5,
    "optimizer_lr_heads_multiplier": 5.0,
    "sampler": "cosmos_unipc",
    "num_inference_steps": 1,
    "single_frame_encode": true,
    "guidance_scale": 1.0,
    "sampler_shift": 5.0
  },
  "steps": 3000,
  "frozen_steps": 200,
  "trunk_warmup_steps": 600,
  "heads_warmup_steps": 200,
  "cooldown_start": 2600,
  "cooldown_steps": 400,
  "seed": 42,
  "reseed_on_resume": true,
  "windows_per_rank": 4,
  "grad_accumulation": 1,
  "num_workers": 6,
  "prefetch_factor": 2,
  "shard_size": 8,
  "param_dtype": "float32",
  "compute_dtype": "bfloat16",
  "reduce_dtype": "float32",
  "activation_checkpointing": true,
  "reshard_after_forward": true,
  "betas": [0.9, 0.99],
  "eps": 1e-08,
  "weight_decay": 0.05,
  "fused_optimizer": true,
  "ema_sigma_rels": [0.1, 0.05],
  "checkpoint_every": 250,
  "keep_checkpoints": 4,
  "keep_every": 500,
  "log_every": 10,
  "resume": "auto"
}
