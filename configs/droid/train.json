{
  "source_root": "outputs/droid/source",
  "index_dir": "outputs/droid/index",
  "output_dir": "outputs/droid/run-seed42",
  "policy": {
    "action_modality": "action_prediction_droid",
    "trunk_weights": "outputs/weights/flux-3-action-base.safetensors",
    "video_vae_id": "outputs/weights/video_vae.safetensors",
    "text_encoder_id": "outputs/weights/text_encoder",
    "attn_mode": "torch"
  },
  "steps": 30000,
  "cooldown_start": 25000,
  "cooldown_steps": 5000,
  "seed": 42,
  "reseed_on_resume": true,
  "windows_per_rank": 32,
  "grad_accumulation": 1,
  "num_workers": 8,
  "prefetch_factor": 2,
  "decoder": "ffmpeg",
  "shard_size": 4,
  "param_dtype": "float32",
  "compute_dtype": "bfloat16",
  "reduce_dtype": "float32",
  "activation_checkpointing": true,
  "reshard_after_forward": true,
  "betas": [0.9, 0.99],
  "eps": 1e-08,
  "weight_decay": 0.05,
  "fused_optimizer": true,
  "ema_sigma_rels": [0.1, 0.05],
  "checkpoint_every": 1000,
  "log_every": 10,
  "resume": "auto"
}
